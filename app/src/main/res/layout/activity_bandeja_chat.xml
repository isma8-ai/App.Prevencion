<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C299CE"
    android:padding="16dp"
    tools:context=".BandejaChatActivity">

    <!-- Top Bar Chat Header -->
    <LinearLayout
        android:id="@+id/topBarChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#D8BFD8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Chat Logo"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 Chat de Alertas y SOS"
                android:textColor="#700483"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 En línea • Monitoreo seguro"
                android:textColor="#1B5E20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRegresarChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regresar"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State View (Shown when no alerts) -->
    <LinearLayout
        android:id="@+id/layoutEmptyChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#D8BFD8"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomInputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarChat">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="💬"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Chat de Alertas Vacío"
            android:textColor="#700483"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="¿Para qué sirve este chat?\n\nEste es tu canal de comunicación directa con la usuaria que estás protegiendo. Aquí aparecerán en tiempo real los mensajes de emergencia, ubicación GPS y alertas SOS cuando se activen.\n\nActualmente no hay alertas activas. El chat está en espera."
            android:textColor="#1E293B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Chat Messages ListView -->
    <ListView
        android:id="@+id/listChatAlertas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#D8BFD8"
        android:dividerHeight="8dp"
        android:padding="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll"
        app:layout_constraintBottom_toTopOf="@id/bottomInputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarChat" />

    <!-- Bottom Chat Input Bar -->
    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#D8BFD8"
            android:hint="Escribe un mensaje..."
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:textColorHint="#475569" />

        <Button
            android:id="@+id/btnEnviarChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar 🚀"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
