<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".perfil">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C299CE"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera con título y botón de Guardar rápido arriba -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:text="Mi Perfil y Ficha de Emergencia"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E647D"
                android:text="Guardar"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="ID CENTINELA (Único):"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCentinelaId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#F6E7FF"
            android:fontFamily="sans-serif"
            android:padding="10dp"
            android:text="CENTINELA-0000"
            android:textAlignment="center"
            android:textColor="#4A148C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Información Personal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Nombre y apellidos"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etDob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Fecha de nacimiento (DD/MM/AAAA)"
            android:inputType="date" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Número de teléfono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ficha Médica de Emergencia (Opcional)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBloodType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Tipo de sangre (ej. O+, A-, etc.)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Alergias (ej. Penicilina, ningún)"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/etMedicalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F6E7FF"
            android:padding="12dp"
            android:textColor="#1E293B"
            android:hint="Información médica relevante (condiciones, medicamentos)"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2E647D"
            android:text="Guardar Perfil y Ficha"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:text="Volver al Menú" />

    </LinearLayout>
</ScrollView>
