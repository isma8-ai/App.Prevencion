<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- Avatar / Icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="Avatar"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo" />

    <!-- Chat Bubble Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="#221C38"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#C299CE"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvChatSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Alerta SOS Recibida"
                android:textColor="#700483"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mensaje de emergencia..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="12:00 PM"
                android:textColor="#9E9E9E"
                android:textSize="10sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
