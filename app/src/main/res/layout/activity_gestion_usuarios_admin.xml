<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8BFD8"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👥 Usuarios Registrados (Admin)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etBuscarUsuario"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="#FFEBEE"
        android:hint="Buscar por nombre de usuario..."
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="#370483"
        android:textColorHint="#471C87"
        android:textStyle="italic" />

    <ListView
        android:id="@+id/listUsuariosAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#FFEBEE"
        android:divider="@drawable/bg_menu_button"
        android:dividerHeight="2dp"
        android:padding="6dp" />

    <Button
        android:id="@+id/btnVolverAdminUsuarios"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#5D4894"
        android:text="Volver"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>